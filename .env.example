# Sahakar Setu / NCCT-Connect - Environment Variables
# Copy to .env and fill in your values

# ==========================================
# Database (MongoDB)
# ==========================================
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=password
MONGO_DB=sahakar

# ==========================================
# Redis
# ==========================================
REDIS_URL=redis://redis:6379

# ==========================================
# MinIO (S3-compatible storage)
# ==========================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=sahakar-files

# ==========================================
# Keycloak (Auth)
# ==========================================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak

# ==========================================
# JWT / API Gateway
# ==========================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=sahakar
KEYCLOAK_CLIENT_ID=api-gateway

# ==========================================
# Service URLs (internal Docker network)
# ==========================================
ERP_SERVICE_URL=http://erp-service:8001
LMS_SERVICE_URL=http://lms-service:8002
ATTENDANCE_SERVICE_URL=http://attendance-service:8003
EMPLOYMENT_SERVICE_URL=http://employment-service:8004
ANALYTICS_SERVICE_URL=http://analytics-service:8005
AI_SERVICE_URL=http://ai-service:8006

# ==========================================
# External APIs (fill in your keys)
# ==========================================
# OpenAI (for quiz generation, embeddings, chat)
OPENAI_API_KEY=

# Google Gemini (alternative to OpenAI)
GEMINI_API_KEY=

# Bhashini (Govt translation API)
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=

# Pinecone (Vector database for embeddings/RAG)
PINECONE_API_KEY=
PINECONE_INDEX=sahakar-embeddings

# ==========================================
# Frontend (Web Admin)
# ==========================================
VITE_API_GATEWAY_URL=http://localhost:3000
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=sahakar
VITE_KEYCLOAK_CLIENT_ID=web-admin

# ==========================================
# Development
# ==========================================
NODE_ENV=development
PYTHON_ENV=development