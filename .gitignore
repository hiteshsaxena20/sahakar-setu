# =============================================================================
# Sahakar Setu — Monorepo .gitignore
# Covers: Node/React (Vite), Python (FastAPI), Flutter, Docker, OS & Editors
# =============================================================================


# =============================================================================
# SECRETS & ENVIRONMENT FILES
# =============================================================================
.env
.env.*
!.env.example
*.pem
*.key
secrets/
*_secret*
*_credentials*


# =============================================================================
# NODE / NPM / YARN / PNPM  (clients/web-admin, packages/shared, api-gateway)
# =============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
lerna-debug.log*

# Build output
dist/
dist-ssr/
build/
out/
.output/

# Vite cache
.vite/

# TypeScript build info
*.tsbuildinfo

# Next.js (if added later)
.next/
.vercel/

# Testing
coverage/
.nyc_output/
test-results/
playwright-report/

# Misc JS tooling
.eslintcache
.stylelintcache
.parcel-cache/


# =============================================================================
# PYTHON  (all services under services/)
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
.venv/
venv/
env/
ENV/
.venv*/

